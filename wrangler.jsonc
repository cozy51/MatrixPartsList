{
  // Cloudflare Workers の設定。画面（dist）と API（worker/index.ts）を1つのWorkerで配信する。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matrix-parts-list",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Workerから画面のファイルを返すための参照（env.ASSETS）。
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 画面のファイルも含め、すべてのリクエストをWorkerで受けてAccessのJWTを検証してから返す。
    // Access側の設定が漏れていても、ログインしていない人に画面を返さないため。
    "run_worker_first": true
  },
  // 独自ドメインは使わず、workers.dev（https://matrix-parts-list.<サブドメイン>.workers.dev）で公開する。
  // workers.dev にはダッシュボードでCloudflare Accessを有効にする（README「Cloudflare設定」）。
  "workers_dev": true,
  // プレビューURL（<版>-matrix-parts-list.<サブドメイン>.workers.dev）は作らない。Workerも APP_HOST 以外のホストを拒否する。
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matrix-parts-list",
      // Cloudflareで作成したD1（matrix-parts-list）のID。
      "database_id": "d4d50279-4773-49be-bdd1-274a9836afd6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "matrix-parts-list-images" }
  ],
  "vars": {
    // 3つとも設定するまで、Workerはすべてのリクエストを拒否する（設定漏れのまま公開されないように）。
    // Cloudflare Access のチームドメイン（例: example.cloudflareaccess.com）。
    "ACCESS_TEAM_DOMAIN": "",
    // workers.dev に有効にしたAccessアプリのAUDタグ。
    "ACCESS_AUD": "",
    // 公開するホスト名（例: matrix-parts-list.example.workers.dev）。これ以外のホストからは使えない。
    "APP_HOST": ""
  }
}
